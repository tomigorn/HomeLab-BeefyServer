@@ -0,0 +1,7 @@
+(function () {
+  var el = document.getElementById('__HG_TURBOPACK_BOOTSTRAP__');
+  if (!el) return;
+  var data = JSON.parse(el.textContent);
+  var queue = globalThis[data[0]] || (globalThis[data[0]] = []);
+  for (var i = 1; i < data.length; i++) queue.push(data[i]);
+})();
