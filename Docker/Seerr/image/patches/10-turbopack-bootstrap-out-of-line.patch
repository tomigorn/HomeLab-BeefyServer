+import type { JSX, ReactNode } from 'react';
+
+type TurbopackManifest = {
+  pagesChunkGroupBootstrapParams?: Record<string, unknown>;
+  chunkLoadingGlobal?: string;
+};
+
+// Turbopack's per-page inline bootstrap <script> is blocked by script-src 'self': its data goes into a JSON element, /hg-turbopack-bootstrap.js runs it.
+const OutOfLineBootstrap = ({
+  children,
+}: {
+  children: (bootstrap: ReactNode) => ReactNode;
+}) => (
+  <HtmlContext.Consumer>
+    {(ctx) => {
+      const manifest = ctx?.buildManifest as
+        | (NonNullable<typeof ctx>['buildManifest'] & TurbopackManifest)
+        | undefined;
+      if (
+        !ctx ||
+        !manifest?.pagesChunkGroupBootstrapParams ||
+        !manifest.chunkLoadingGlobal
+      ) {
+        return children(null);
+      }
+      const {
+        pagesChunkGroupBootstrapParams: params,
+        chunkLoadingGlobal: global,
+        ...buildManifest
+      } = manifest;
+      const data = JSON.stringify([
+        global,
+        ...['/_app', ctx.__NEXT_DATA__.page]
+          .map((page) => params[page])
+          .filter(Boolean),
+      ]).replace(/</g, '\\u003c');
+      return (
+        <HtmlContext.Provider value={{ ...ctx, buildManifest }}>
+          {children(
+            <>
+              <script
+                id="__HG_TURBOPACK_BOOTSTRAP__"
+                type="application/json"
+                dangerouslySetInnerHTML={{ __html: data }}
+              />
+              <script src="/hg-turbopack-bootstrap.js" />
+            </>
+          )}
+        </HtmlContext.Provider>
+      );
+    }}
+  </HtmlContext.Consumer>
+);
 
