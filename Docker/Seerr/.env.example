COMPOSE_PROJECT_NAME=seerr

# Local time, so request timestamps match the clock on the wall
TZ=Europe/Zurich

# info is enough; debug logs every TMDB call
LOG_LEVEL=info

# Container config and database (settings.json holds Seerr's API key and the
# Jellyfin access token; keep it out of git). On the NVMe like the other apps.
APPDATA_ROOT=/srv/appdata

# Host port. Traefik on fastpi reaches it at 192.168.1.102:5055; the beefy
# firewall drops this port from everyone else (DOCKER-USER rule).
SEERR_PORT=5055
