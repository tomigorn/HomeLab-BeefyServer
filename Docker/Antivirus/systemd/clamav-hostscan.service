[Unit]
Description=ClamAV whole-host scan, chunked and resumable (container without network)
Documentation=file:///home/buntu/Projects/Docker/Antivirus/README.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker compose --project-directory /home/buntu/Projects/Docker/Antivirus run --rm --name clamav-hostscan clamav-hostscan
ExecStopPost=-/usr/bin/docker rm -f clamav-hostscan
# Exit 1 = infected files found (report only); the alert reports those, the unit only fails on scan errors.
SuccessExitStatus=1
# The scan stops itself at 04:40 (SCAN_WINDOW) and resumes the next night; clamd start and the last chunk fit before the window drain.
TimeoutStartSec=40m
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
# Sandbox of the docker client only: the scan itself runs in the hardened container (README, Two containers).
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=true
PrivateNetwork=true
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
# compose reads the project in ~buntu (0750)
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077
