COMPOSE_PROJECT_NAME=ryot

# Image tag (update: back up first, see README)
RYOT_TAG=v10.5.3

# Local time
TZ=Europe/Zurich

# Database on the NVMe like the other apps: ${APPDATA_ROOT}/ryot-db
APPDATA_ROOT=/srv/appdata

# Host port. Traefik on fastpi reaches it at 192.168.1.102:8010; the beefy
# firewall drops this port from everyone else (DOCKER-USER rule).
RYOT_PORT=8010

# Host port of ryot-go (the /go/tmdb/... redirect for the Jellyfin link), same firewall rule as RYOT_PORT
RYOT_GO_PORT=8011

# Postgres password (openssl rand -hex 24); DATABASE_URL is built from it in docker-compose.yaml
# -> secrets/ryot_db_password (70:1001 0440); ryot builds DATABASE_URL from it in its entrypoint

# Read-only role ryot_go (SELECT on metadata only, README Setup); openssl rand -hex 24
# -> secrets/ryot_go_pgpass (65110 0400, pgpass line *:*:*:ryot_go:<password>)

# Ryot
FRONTEND_URL=https://tracker.holy-grail.ch
# openssl rand -hex 32
# -> secrets/ryot_admin_access_token (1001 0400)
DISABLE_TELEMETRY=true
SERVER_GRAPHQL_PLAYGROUND_ENABLED=false

# Login only via Holy Grail (Authentik app tracker-login); registration on = OIDC users are created on first login
USERS_ALLOW_REGISTRATION=true
USERS_DISABLE_LOCAL_AUTH=true
FRONTEND_OIDC_BUTTON_LABEL=Sign in with Holy Grail
SERVER_OIDC_ISSUER_URL=https://sso.holy-grail.ch/application/o/tracker-login/
# Written from fastpi by HomeLab-FastPi Authentik/scripts/provision-tracker-sso.py
SERVER_OIDC_CLIENT_ID=
# Secret -> secrets/ryot_oidc_client_secret (1001 0400)

# TMDB "API Read Access Token" (themoviedb.org account settings, API)
# -> secrets/ryot_tmdb_access_token (1001 0400)
