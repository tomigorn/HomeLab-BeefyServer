{
  "$schema": "https://raw.githubusercontent.com/sergi0g/cup/main/cup.schema.json",
  "version": 3,
  "agent": true,
  "refresh_interval": "0 0 4 * * Sun",
  "ignore_update_type": "none",
  "registries": {
    "rollback.invalid": { "ignore": true }
  },
  "images": {
    "exclude": [
      "jellyfin-local",
      "clamav-local",
      "rollback.invalid/"
    ],
    "extra": [
      "lscr.io/linuxserver/jellyfin:12.4ubu2604-ls57"
    ]
  }
}
