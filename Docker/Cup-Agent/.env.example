COMPOSE_PROJECT_NAME=cup-agent

# Must match the tag fastpi's Cup runs — the agent API is versioned alongside the
# server, and a mismatched major could fail to parse.
CUP_IMAGE_TAG=v3.5.1

# Published on the LAN so fastpi can poll it. Protected by the DOCKER-USER rule
# on this host, which restricts it to 192.168.1.2 — if you change this port you
# MUST also update that rule, or the agent becomes world-readable on the LAN.
AGENT_PORT=8000
