COMPOSE_PROJECT_NAME=subtitle-translate

# Local time, so log timestamps match the clock on the wall
TZ=Europe/Zurich

# Container state outside the repo
APPDATA_ROOT=/srv/appdata

# Lingarr on 127.0.0.1 only (the orchestrator runs on the host)
LINGARR_PORT=9876

# CPU cap for LibreTranslate (6 cores; transcoding is on the iGPU)
TRANSLATE_CPUS=3

# Loaded models (Argos codes). Add one: append here, then scripts/install-models.sh and docker compose up -d
LT_LANGUAGES=en,de,fr,es,it,pt,ru,sv,da,nb,nl,pl,ja,ko,zh,zt,fa,hi
