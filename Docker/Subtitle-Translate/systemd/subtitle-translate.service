[Unit]
Description=Translated subtitle fallback: German/English from the best human subtitle when Bazarr found none after 48 h, one title at a time
Documentation=file:///home/buntu/Projects/Docker/Subtitle-Translate/README.md
RequiresMountsFor=/srv/video /srv/appdata
After=docker.service

[Service]
Type=oneshot
User=buntu
UMask=0002
Environment=ST_STOP_AT=05:50
Environment=ST_WAIT_HOURS=48
# Hold beefy awake only when nobody holds it, release only what this run took (same pattern as the maintenance window).
ExecStartPre=+/bin/sh -c 'rm -f /run/subtitle-translate-keep-awake; [ -e /run/beefy-keep-awake ] || { /usr/local/sbin/beefy-keep-awake on && touch /run/subtitle-translate-keep-awake; }'
ExecStart=/home/buntu/Projects/Docker/Subtitle-Translate/scripts/subtitle-translate.py
ExecStopPost=+/bin/sh -c '[ -e /run/subtitle-translate-keep-awake ] && /usr/local/sbin/beefy-keep-awake off; rm -f /run/subtitle-translate-keep-awake'
TimeoutStartSec=90min
Nice=19
IOSchedulingClass=idle
CPUWeight=20
NoNewPrivileges=true
PrivateTmp=true
# Parses subtitle files from releases (untrusted): only loopback (Bazarr, Radarr, Sonarr, Lingarr, Jellyfin), writes only its state and the translated files.
ReadWritePaths=/srv/appdata/subtitle-translate /srv/video/media
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
# mkvextract lowers its own priority (@resources), so only @privileged is denied.
SystemCallFilter=~@privileged
