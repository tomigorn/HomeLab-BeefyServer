COMPOSE_PROJECT_NAME=jellyfin

# Local time, so "added today" and scheduled tasks match the clock on the wall
TZ=Europe/Zurich

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# Same uid/gid as the Movie-Downloads stack, so Jellyfin can read what Radarr
# wrote. beefy has no such user yet - see "Prerequisites" in README.md.
PUID=1101
PGID=1100

# beefy's `render` group id, for QuickSync hardware transcoding. Confirm after
# any OS upgrade, since this is assigned dynamically:
#   getent group render
RENDER_GID=990

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# The library only - NOT the downloads tree. Mounted read-only; Radarr owns this
# and Jellyfin has no reason to write to it.
MEDIA_ROOT=/srv/video/media

# Jellyfin's config, database and metadata cache. On the NVMe, not on
# /srv/video: it is small, constantly written, and would otherwise keep the
# media disks spinning. It grows to a few GB once artwork is cached.
APPDATA_ROOT=/srv/appdata

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
JELLYFIN_PORT=8096

# The public URL Traefik serves this on. Jellyfin uses it to build absolute
# links; clients misbehave if it disagrees with how they actually connected.
PUBLISHED_SERVER_URL=https://jellyfin.holy-grail.ch
