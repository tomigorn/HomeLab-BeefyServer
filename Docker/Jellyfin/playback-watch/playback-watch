#!/usr/bin/env python3
import argparse
import ipaddress
import json
import signal
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import autofix  # noqa: E402
import record  # noqa: E402
import tracker as tracker_mod  # noqa: E402

POLL = 5.0
REVERT_AFTER = 600.0
APPLY_EVERY = 60.0
STATE_DIR = Path.home() / ".local" / "state" / "jellyfin-playback"
KEY_FILE = HERE.parent / "secrets" / "api-key"
DOWNLOADS = HERE.parent.parent / "Movie-Downloads" / "secrets"
DOWNLOADS_BASE = "http://movie-gluetun"
QBIT_PASSWORD = DOWNLOADS / "qbit-webui.password"
SAB_KEY = DOWNLOADS / "hook" / "sabnzbd.apikey"
INSPECT = ["sudo", "-n", "docker", "inspect", "-f", "{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}", "jellyfin"]
INSPECT_GLUETUN = ["sudo", "-n", "docker", "inspect", "-f",
                   "{{range $k, $v := .NetworkSettings.Networks}}{{$k}}={{$v.IPAddress}} {{end}}", "movie-gluetun"]


def log_stdout(msg):
    print(msg, flush=True)


def http_get(url, headers, timeout=5):
    with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=timeout) as r:
        return r.read()


def own_addresses(run):
    r = run(["ip", "-o", "-4", "addr", "show"], capture_output=True, text=True, timeout=10)
    addrs = set()
    for line in r.stdout.splitlines():
        f = line.split()
        if "inet" in f and f.index("inet") + 1 < len(f):
            addrs.add(f[f.index("inet") + 1].split("/")[0])
    return addrs


def safe_ip(ip, own):
    if not ip or ip == "localhost" or ip in own:
        return False
    try:
        a = ipaddress.ip_address(ip)
    except ValueError:
        return False
    return not (a.is_loopback or a.is_unspecified)


def parse_duration(text):
    units = {"s": 1, "m": 60, "h": 3600, "d": 86400}
    text = text.strip().lower()
    if text[-1:] in units:
        return int(float(text[:-1]) * units[text[-1]])
    if text.isdigit():
        return int(text)
    raise ValueError(f"bad duration {text!r} (use 30s, 90m, 24h, 2d)")


class DownloadsHttp:
    """qBittorrent and SABnzbd share movie-gluetun's namespace: call them at its bridge IP, 127.0.0.1 only when that refuses."""

    def __init__(self, run, http, log):
        self.run, self.http, self.log = run, http, log
        self.ip = None

    def _resolve(self):
        try:
            r = self.run(INSPECT_GLUETUN, capture_output=True, text=True, timeout=20)
            pairs = [f.partition("=") for f in r.stdout.split()] if r.returncode == 0 else []
            ips = [ip for net, _, ip in pairs if net == "movie-downloads" and ip] + [ip for _, _, ip in pairs if ip]
            ip = ips[0] if ips else None
            if safe_ip(ip, own_addresses(self.run)):
                return ip
            self.log(f"downloads: no usable movie-gluetun bridge IP ({ip!r}), using 127.0.0.1")
        except Exception as e:
            self.log(f"downloads: resolving movie-gluetun failed: {e}")
        return None

    def __call__(self, url, data=None):
        if self.ip is None:
            self.ip = self._resolve()
        if self.ip:
            try:
                return self.http(url.replace(DOWNLOADS_BASE, f"http://{self.ip}", 1), data)
            except OSError as e:
                self.log(f"downloads: {self.ip} refused ({e}), falling back to 127.0.0.1")
                self.ip = None
        return self.http(url.replace(DOWNLOADS_BASE, "http://127.0.0.1", 1), data)


class Watcher:
    def __init__(self, *, run, http, clock, key_file, fix, state_dir, log, tracker=None, context=record.context):
        self.run_cmd, self.http, self.clock = run, http, clock
        self.key_file, self.fix, self.log, self.context = Path(key_file), fix, log, context
        self.state_dir = Path(state_dir)
        self.tracker = tracker or tracker_mod.Tracker(clock)
        self.counters = record.Counters(self.state_dir / "state.json")
        self.incidents_path = self.state_dir / "incidents.jsonl"
        self.prom_path = self.state_dir / "playback.prom"
        self.base = self.key = None
        self.started = clock()
        self.last_ok = 0.0
        self.reverting = False
        self.last_apply = None
        self.playbacks = {}
        fix.on_action = self._count_action

    def _count_action(self, action):
        try:
            self.counters.inc_autofix(action)
        except OSError as e:
            self.log(f"counters: save failed: {e}")

    def _resolve(self):
        r = self.run_cmd(INSPECT, capture_output=True, text=True, timeout=20)
        ip = next(iter(r.stdout.split()), None) if r.returncode == 0 else None
        if not safe_ip(ip, own_addresses(self.run_cmd)):
            raise RuntimeError(f"refusing Jellyfin address {ip!r}: not a container bridge IP")
        self.key = self.key_file.read_text().strip()
        self.base = f"http://{ip}:8096"
        self.log(f"polling Jellyfin at {self.base}")

    def fetch(self):
        if self.base is None:
            self._resolve()
        try:
            body = self.http(self.base + "/Sessions?ActiveWithinSeconds=60",
                             {"Authorization": f'MediaBrowser Token="{self.key}"'})
            return json.loads(body)
        except Exception:
            self.base = None
            raise

    def poll(self):
        now = self.clock()
        try:
            sessions = self.fetch()
        except Exception as e:
            self.log(f"poll failed: {e}")
            if now - max(self.last_ok, self.started) >= REVERT_AFTER:
                self._revert(now)
            return False
        self.last_ok = now
        incidents = self.tracker.update(sessions, now)
        self._track_playbacks(sessions, incidents, now)
        for inc in incidents:
            self._record(inc, now)
        playing = self.tracker.playing()
        if playing and self.tracker.episode_active(now):
            self.reverting = False
            done = self._step("complete", self.fix.complete)
            if not done or self.last_apply is None or now - self.last_apply >= APPLY_EVERY:
                self.last_apply = now
                self._step("apply", lambda: self.fix.apply(now))
        else:
            end = self.tracker.last_playing_end()
            idle = not playing and now - (end if end is not None else self.started) >= REVERT_AFTER
            if idle or self.reverting:
                self._revert(now)
        return True

    def _revert(self, now):
        if any(self.fix.active().values()):
            self._step("revert", self.fix.revert)
            self.reverting = any(self.fix.active().values())
        else:
            self.reverting = False

    def _step(self, what, fn):
        try:
            return fn()
        except Exception as e:
            self.log(f"autofix {what} failed: {e}")

    def _record(self, inc, now):
        client = inc.get("client") or "unknown"
        self.log(f"incident {inc['kind']} {inc['seconds']:.1f}s client={client} method={inc.get('play_method')}")
        try:
            self.counters.inc_incident(inc["kind"], client, inc["seconds"], now)
        except OSError as e:
            self.log(f"counters: save failed: {e}")
        try:
            qbit, sab = self.fix.download_speeds()
            ctx = self.context(qbit_speed=qbit, sab_speed=sab, autofix_active=self.fix.active())
            record.append_incident(self.incidents_path, inc, ctx)
        except Exception as e:
            self.log(f"incident log failed: {e}")

    def _track_playbacks(self, sessions, incidents, now):
        current = {}
        for s in sessions:
            item = s.get("NowPlayingItem")
            if item:
                name = item.get("Name") or ""
                current[s.get("Id")] = (f"{item['SeriesName']} - {name}" if item.get("SeriesName") else name, s)
        for sid, pb in list(self.playbacks.items()):
            if sid not in current or current[sid][0] != pb["item"]:
                self._summary(self.playbacks.pop(sid), now)
        for sid, (name, s) in current.items():
            if sid not in self.playbacks:
                self.playbacks[sid] = {
                    "session_id": sid, "user": s.get("UserName"), "client": s.get("Client"), "device": s.get("DeviceName"),
                    "item": name, "play_method": (s.get("PlayState") or {}).get("PlayMethod"),
                    "started": now, "incidents": {}, "stall_seconds": 0.0,
                }
        for inc in incidents:
            pb = self.playbacks.get(inc.get("session_id"))
            if pb:
                pb["incidents"][inc["kind"]] = pb["incidents"].get(inc["kind"], 0) + 1
                if inc["kind"] == "stall":
                    pb["stall_seconds"] += inc["seconds"]

    def _summary(self, pb, now):
        try:
            record.append_summary(self.incidents_path, {**pb, "ended": now, "duration": now - pb["started"]})
        except Exception as e:
            self.log(f"summary log failed: {e}")

    def write_prom(self):
        try:
            record.write_prom(self.prom_path, self.counters, self.tracker.active_by_method(), self.fix.active(), self.last_ok)
        except Exception as e:
            self.log(f"metrics write failed: {e}")

    def poll_once(self):
        try:
            self.poll()
        except Exception as e:
            self.log(f"poll error: {type(e).__name__}: {e}")
        self.write_prom()

    def run(self, stop):
        self._step("restore", self.fix.restore_from_state)
        self.reverting = any(self.fix.active().values())
        while not stop.is_set():
            start = self.clock()
            self.poll_once()
            stop.wait(max(0.0, POLL - (self.clock() - start)))
        self._step("revert", self.fix.revert)
        self.write_prom()
        self.log("stopped")


def install_signals(stop):
    old = {}
    for sig in (signal.SIGTERM, signal.SIGINT):
        old[sig] = signal.signal(sig, lambda *_: stop.set())
    return old


def build_fix(log):
    http = DownloadsHttp(subprocess.run, autofix.make_http(), log)
    try:
        sab_key = SAB_KEY.read_text().strip()
    except OSError as e:
        log(f"SABnzbd key unreadable: {e}")
        sab_key = ""
    return autofix.AutoFix(autofix.Qbit(DOWNLOADS_BASE + ":8080", QBIT_PASSWORD, http), autofix.Sab(DOWNLOADS_BASE + ":8081", sab_key, http),
                           autofix.Systemd(), STATE_DIR / "autofix.json", log=log)


def main(argv=None, state_dir=STATE_DIR, out=print):
    parser = argparse.ArgumentParser(prog="playback-watch", description="Jellyfin playback stutter watch")
    sub = parser.add_subparsers(dest="cmd")
    rep = sub.add_parser("report", help="print recorded incidents")
    rep.add_argument("--since", default="24h", help="time window, e.g. 30m, 24h, 7d (default 24h)")
    args = parser.parse_args(argv)
    if args.cmd == "report":
        try:
            since = parse_duration(args.since)
        except ValueError as e:
            parser.error(str(e))
        out(record.report(Path(state_dir) / "incidents.jsonl", since))
        return 0
    stop = threading.Event()
    install_signals(stop)
    watcher = Watcher(run=subprocess.run, http=http_get, clock=time.time, key_file=KEY_FILE, fix=build_fix(log_stdout),
                      state_dir=state_dir, log=log_stdout)
    watcher.run(stop)
    return 0


if __name__ == "__main__":
    sys.exit(main())
