[Unit]
Description=Weekly Docker image cleanup (unused images and build cache older than 14 days, rollback window kept)
Documentation=file:///home/buntu/Projects/Docker/_global/docs/image-cleanup.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=buntu
Group=buntu
SupplementaryGroups=docker
StateDirectory=image-cleanup
Environment=HOME=/home/buntu
Environment=IMAGE_CLEANUP_STATE=/var/lib/image-cleanup
Environment="IMAGE_CLEANUP_KEEP=aquasec/trivy ghcr.io/gitleaks/gitleaks"
Environment=IMAGE_CLEANUP_TEXTFILE=/var/lib/auto-update/textfile
# Own keep-awake hold while running; other holds stay.
ExecStartPre=+/usr/local/sbin/beefy-keep-awake on image-cleanup
ExecStart=/home/buntu/Projects/Docker/_global/scripts/image-cleanup.sh
TimeoutStartSec=300
ExecStopPost=+/usr/local/sbin/beefy-keep-awake off image-cleanup
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
