COMPOSE_PROJECT_NAME=activity-gate

# Seerr bar state files live in ${APPDATA_ROOT}/indexer-bar
APPDATA_ROOT=/srv/appdata

# Host port fastpi polls (HomeLab-FastPi Docker/Activity GATE_URL). Must stay in EXCLUDE_PORTS of /etc/beefy-idle.conf.
GATE_PORT=8095

# Keys are files, not variables: secrets/jellyfin.apikey, secrets/radarr.apikey, secrets/sonarr.apikey (README "Secrets")
