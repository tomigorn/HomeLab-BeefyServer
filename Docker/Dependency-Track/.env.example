COMPOSE_PROJECT_NAME=dependency-track

# Image tag of apiserver and frontend (same release; update: back up the DB first, README)
DT_TAG=4.14.5

# Local time
TZ=Europe/Zurich

# Data + database on the NVMe like the other apps: ${APPDATA_ROOT}/dependency-track(-db)
APPDATA_ROOT=/srv/appdata

# Host port (UI + /api). fastpi reaches it at 192.168.1.102:8090; the beefy firewall drops it from everyone else (DOCKER-USER rule).
DT_PORT=8090

# Postgres password (openssl rand -hex 24)
# -> secrets/dt_db_password (70:65122 0440)
# Admin password (set at first start, README) -> secrets/dt_admin_password (buntu 0400), never read by a container
