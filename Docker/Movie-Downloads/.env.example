COMPOSE_PROJECT_NAME=movie-downloads

# Local time, so schedules and log timestamps match the clock on the wall
TZ=Europe/Zurich

# ---------------------------------------------------------------------------
# Identity — storage doc §14.0 "Decided values (use these verbatim)"
# ---------------------------------------------------------------------------
# ONE shared identity for every media container (download clients, arrs, Jellyfin,
# Bazarr). This is the `buntu` user, which already exists as 1000:1000, so nothing
# needs creating. /srv/audio was already chowned under this same decision.
PUID=1000
PGID=1000

# NOT optional. New files come out group-writable, which is what lets one
# container hardlink or edit a file another container wrote. Get this wrong and
# Radarr's imports fail or silently fall back to full copies.
UMASK=002

# ---------------------------------------------------------------------------
# Storage — storage doc §13.2 layout
# ---------------------------------------------------------------------------
# ONE root for downloads AND the library, mounted into every container as /data:
#
#   /srv/video/torrents/movies           qBittorrent (radarr category)
#   /srv/video/usenet/incomplete         SABnzbd scratch + unpack
#   /srv/video/usenet/complete/movies    SABnzbd finished, pre-import
#   /srv/video/media/movies              Radarr library; Jellyfin reads it :ro
#   /srv/video/.recyclebin               arr recycle bin (kept on the SSD)
#
# One mount is what makes Radarr hardlink instead of copy, and it only works
# because everything above lives on the same mergerfs branch. Do NOT split this
# into separate /downloads and /movies mounts: mergerfs can only hardlink within
# one branch, and a cross-branch rename returns EXDEV, so a split mount silently
# turns every import into a full copy.
DATA_ROOT=/srv/video

# Container configs and databases. On the NVMe, NOT on /srv/video: they are small,
# written constantly, and would otherwise keep the media disks spinning.
APPDATA_ROOT=/srv/appdata

# ---------------------------------------------------------------------------
# VPN (gluetun)
# ---------------------------------------------------------------------------
# A ProtonVPN WireGuard private key that is NOT the one fastpi's `mouse` stack
# uses. Two tunnels presenting the same key fight over the session and both drop
# intermittently. Create a second config in the Proton portal
# (Downloads -> WireGuard configuration) and paste its PrivateKey here.
# Pick a server that supports port forwarding, or torrents stay unconnectable.
PROTONVPN_PRIVATE_KEY=

# Comma-separated. Keep it short for lower latency.
VPN_SERVER_COUNTRIES=Switzerland

# Your LAN, so you can open the WebUIs from your desktop, and this project's
# bridge, so Radarr/Bazarr/SABnzbd can reach qBittorrent and Prowlarr. gluetun
# drops replies to anything not listed here. BRIDGE_SUBNET must match the subnet
# in docker-compose.yaml.
LAN_SUBNET=192.168.1.0/24
BRIDGE_SUBNET=172.28.10.0/24

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
# qBittorrent and Prowlarr share gluetun's namespace, so compose publishes these
# on the gluetun service, not on their own.
QBITTORRENT_PORT=8080
PROWLARR_PORT=9696
# 8081, because qBittorrent already has 8080 on this host.
SABNZBD_PORT=8081
RADARR_PORT=7878
BAZARR_PORT=6767
