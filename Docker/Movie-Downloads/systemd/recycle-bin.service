[Unit]
Description=Recycle bin: delete files 7 days after they were moved into /srv/video/.recyclebin (not by file date; 04:37)
Documentation=file:///home/buntu/Projects/Docker/Movie-Downloads/README.md
RequiresMountsFor=/srv/video

[Service]
Type=oneshot
User=buntu
ExecStart=/home/buntu/Projects/Docker/Movie-Downloads/scripts/recycle-bin.py
TimeoutStartSec=900
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/video/.recyclebin
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
