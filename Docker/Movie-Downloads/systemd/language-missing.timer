[Unit]
Description=Language-not-found textfile daily 04:18 in the beefy maintenance window, before fastpi pulls it at 04:20+
Documentation=file:///home/buntu/Projects/Docker/Movie-Downloads/README.md

[Timer]
# Inside the beefy maintenance window (03:58-04:45); no boot trigger and no Persistent, so a daytime wake never runs it.
OnCalendar=*-*-* 04:18:00 Europe/Zurich
Persistent=false

[Install]
WantedBy=timers.target
