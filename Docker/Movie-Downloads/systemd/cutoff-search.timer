[Unit]
Description=Weekly cutoff-unmet search, Sunday 04:12 (inside the 03:55 maintenance wake)
Documentation=file:///home/buntu/Projects/Docker/Movie-Downloads/README.md

[Timer]
# No Persistent: a missed run would fire after the next boot, outside the window; next week catches up.
OnCalendar=Sun *-*-* 04:12

[Install]
WantedBy=timers.target
