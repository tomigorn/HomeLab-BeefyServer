[Unit]
Description=Push MULTi usenet releases with the audio languages from their NFO to Radarr and Sonarr
Documentation=file:///home/buntu/Projects/Docker/Movie-Downloads/README.md
After=docker.service

[Service]
Type=oneshot
User=buntu
ExecStart=/home/buntu/Projects/Docker/Movie-Downloads/scripts/nfo-scout.py
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
# Parses indexer NFO text (untrusted): buntu, but sandboxed; writes only its state dir and dub-only.json in the Radarr/Sonarr config dirs.
ReadWritePaths=/home/buntu/.local/state/movie-downloads /srv/appdata/radarr /srv/appdata/sonarr
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
