[Unit]
Description=Original-language audio track as the default track of every movie/episode mkv (README Languages)
Documentation=file:///home/buntu/Projects/Docker/Movie-Downloads/README.md
After=docker.service

[Service]
Type=oneshot
User=buntu
ExecStart=/home/buntu/Projects/Docker/Movie-Downloads/scripts/original-audio.py
AmbientCapabilities=CAP_FOWNER
CapabilityBoundingSet=CAP_FOWNER
NoNewPrivileges=true
PrivateTmp=true
