[Unit]
Description=Night search daily 04:17 in the beefy maintenance window (after Recyclarr 04:15)

[Timer]
# Inside the beefy maintenance window (03:58-04:45); no boot trigger and no Persistent, so a daytime wake never runs it.
OnCalendar=*-*-* 04:17:00 Europe/Zurich
Persistent=false

[Install]
WantedBy=timers.target
