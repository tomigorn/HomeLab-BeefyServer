[Unit]
Description=Seerr availability after a Radarr/Sonarr import: debounce, Jellyfin scan if needed, Seerr full scan (README Seerr availability after an import)
Documentation=file:///home/buntu/Projects/Docker/Movie-Downloads/README.md
After=docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=buntu
TimeoutStartSec=4h
ExecStart=/home/buntu/Projects/Docker/Movie-Downloads/scripts/seerr-sync.sh
NoNewPrivileges=true
PrivateTmp=true
# Sandboxed like subtitle-check, but with localhost APIs: writes only its state dir and the apps' queue dirs (claims seerr-sync.queue).
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/buntu/.local/state/movie-downloads /srv/appdata/radarr /srv/appdata/sonarr
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
