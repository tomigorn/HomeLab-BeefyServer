[Unit]
Description=Seerr Clear Data wipe right after a title was added, so a request cleared within 2 min is in the snapshot
Documentation=file:///home/buntu/Projects/Docker/Movie-Downloads/README.md
After=docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=buntu
ExecStartPre=/bin/sleep 5
ExecStart=/home/buntu/Projects/Docker/Movie-Downloads/scripts/clear-data-wipe.sh
NoNewPrivileges=true
PrivateTmp=true
# Sandboxed like subtitle-check, but with localhost APIs: writes only its state dir.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/buntu/.local/state/movie-downloads
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
