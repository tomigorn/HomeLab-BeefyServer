[Unit]
Description=Forced-subtitle sync daily 04:23 in the beefy maintenance window, after the subtitle check, before the queue watchdog hands findings to fastpi digest
Documentation=file:///home/buntu/Projects/Docker/Movie-Downloads/README.md

[Timer]
# Inside the beefy maintenance window (03:58-04:45); no boot trigger and no Persistent, so a daytime wake never runs it.
OnCalendar=*-*-* 04:23:00 Europe/Zurich
Persistent=false

[Install]
WantedBy=timers.target
