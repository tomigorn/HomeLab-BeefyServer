COMPOSE_PROJECT_NAME=jellyfin-beta

TZ=Europe/Zurich
UMASK=002

# beefy's `render` group id (getent group render), same as ../Jellyfin
RENDER_GID=990

# The library, read-only
MEDIA_ROOT=/srv/video/media
# Config, DB and metadata of the beta: ${APPDATA_ROOT}/jellyfin-beta
APPDATA_ROOT=/srv/appdata

# Published port; only fastpi may reach it (DOCKER-USER)
JELLYFIN_BETA_PORT=8196
PUBLISHED_SERVER_URL=https://jellyfin-beta.holy-grail.ch
