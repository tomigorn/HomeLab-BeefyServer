COMPOSE_PROJECT_NAME=floppy

# Images, pinned by tag and digest. Update by hand only (README "Update"): migrations are one-way.
FLOPPY_TAG=26.10.29@sha256:5e88307d4af68ee397f0233670b4f35f50d6ce5d12c34fde6b9ecab74ac4836e
REDIS_TAG=8.10.3-alpine@sha256:896f241f438ab6a210cfb24f573b84bea721a4cbe67f1b4fd07eb638b3b02a7b

# Local time
TZ=Europe/Zurich

# Data on the NVMe: ${APPDATA_ROOT}/floppy/{db,backups}, ${APPDATA_ROOT}/floppy-redis
APPDATA_ROOT=/srv/appdata

# Host port. Traefik on fastpi reaches it at 192.168.1.102:8012; the beefy firewall drops it for everyone else (DOCKER-USER).
FLOPPY_PORT=8012

# Django secret key (openssl rand -hex 50)
# -> secrets/floppy_secret (65125:65125 0400)

# Redis password (openssl rand -hex 32)
# -> secrets/floppy_redis_password (65126:65125 0440)

# allauth OIDC provider JSON (client id + secret of Authentik app tracker-login)
# Written from fastpi by HomeLab-FastPi Authentik/scripts/provision-tracker-sso.py
# -> secrets/floppy_oidc_providers (65125:65125 0400)
