[Unit]
Description=Nightly beefy tiering mover (04:00 window)
Documentation=file:///home/buntu/Projects/Server/3-Storage-Layout-and-Spindown.md

[Timer]
# The decided mover window: the ONE slot the cold HDD is allowed to wake, so it spins up once a night instead of being trickle-woken all day.
# beefy is up 03:55-04:45 (Server/9-Night-Schedule.md), so the slot is always met; Persistent=false keeps a missed night from running at noon.
OnCalendar=*-*-* 04:00:00 Europe/Zurich
RandomizedDelaySec=300
Persistent=false

[Install]
WantedBy=timers.target
