[Unit]
Description=Beefy tiering mover (demote cold video SSD -> HDD)
Documentation=file:///home/buntu/Projects/Server/3-Storage-Layout-and-Spindown.md
# The pool must be up, or the mover would walk an empty directory and conclude
# there is nothing to demote.
RequiresMountsFor=/srv/video
After=srv-video.mount
Requires=srv-video.mount

[Service]
Type=oneshot
EnvironmentFile=-/etc/beefy-mover.conf
ExecStart=/usr/local/sbin/beefy-mover
# The mover stops starting titles at DEADLINE (04:40, /etc/beefy-mover.conf); this hard stop at 60 min only catches a pathological run. Being killed is SAFE: tier-helper copies into .tier-staging and only deletes a source after the copy was verified and renamed into place.
#
# TimeoutStartSec, not RuntimeMaxSec: for Type=oneshot the whole ExecStart is the
# "start" phase, and systemd-analyze verify flags RuntimeMaxSec as having no effect
# here. It would have silently done nothing.
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=idle

# Hardening. Needs real write access to /srv, so ProtectSystem=full rather than
# strict, and ReadWritePaths for the pool and its metrics file.
NoNewPrivileges=true
ProtectSystem=full
# read-only: the Jellyfin API key lives in the Jellyfin project under /home/buntu
ProtectHome=read-only
ReadWritePaths=/srv/video /srv/.disks /run /var/lib/beefy-mover
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

# Deliberately NO [Install] section. This is a oneshot activated by
# beefy-mover.timer, and the timer does not need the service to be enabled. Having
# WantedBy=multi-user.target here would invite someone to `systemctl enable
# beefy-mover.service`, which makes it run on EVERY boot - outside the mover window
# and without the timer's randomised delay. Enable the TIMER, never the service.
